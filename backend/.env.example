PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/brunch-cafe
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
# Sesión del personal sin "*" (mesero, cocina…) en tablets: 12 h por defecto
# JWT_EXPIRES_IN_STAFF=12h
# Uno o varios orígenes del frontend separados por coma
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Opcional: trace | debug | info | warn | error | silent
LOG_LEVEL=debug
# Cookie de sesión (por defecto: secure solo en production, sameSite=lax).
# Frontend y API en sitios distintos en producción: COOKIE_SAMESITE=none y COOKIE_SECURE=true
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# Número de proxies delante de la API (Nginx, Render, etc.) para que el rate limit vea la IP real
# TRUST_PROXY=1
# Primer administrador (lo usa `npm run seed:base`; la contraseña nunca se imprime)
# ADMIN_EMAIL=admin@brunchcafe.co
# ADMIN_PASSWORD=cambia-esta-clave-larga   (mínimo 10 caracteres)
# ADMIN_NOMBRE=Nombre Apellido

# Solo desarrollo: contraseña de los usuarios de prueba *.dev@brunchcafe.test (npm run seed:dev / npm run capturas)
# DEV_USUARIOS_PASSWORD=una-clave-de-prueba-larga

# SMTP para la recuperación de contraseña y la confirmación de reservas (0.16; ya no se usa EmailJS).
# Sin SMTP no se envían correos; en NODE_ENV=development el enlace o el contenido del correo aparecen
# en el log del backend para poder probar el flujo (ver README).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=cuenta@example.com
# SMTP_PASSWORD=contraseña-de-aplicación
# SMTP_FROM=Brunch Café <cuenta@example.com>
